# Required
AIDI_API_TOKEN=

# Optional (default: https://app.ausbildung-in-der-it.de)
# AIDI_HOST_URL=http://localhost:8000
# AIDI_HOST_URL=https://staging.ausbildung-in-der-it.de
# AIDI_HOST_URL=https://app.ausbildung-in-der-it.de

# Admin-Befehle (lernplattform kuendigungen), eigener Token pro Person und Umgebung.
# Anlegen im Backoffice: System > API Tokens, Besitzer = du selbst,
# Scopes cancellation-requests:read und cancellation-requests:write.
# LERNPLATTFORM_ADMIN_TOKEN=
# LERNPLATTFORM_STAGING_ADMIN_TOKEN=
# LERNPLATTFORM_ENV=staging                      # Default für --env (sonst production)
# LERNPLATTFORM_BASE_URL=http://127.0.0.1:8000   # nur für lokale Instanzen
# staging liegt hinter nginx-Basic-Auth, Format user:passwort.
# Zugangsdaten: aidi-handbook, docs/tools/plattform-staging.md (bzw. 1Password-Eintrag von dort).
# LERNPLATTFORM_STAGING_BASIC_AUTH=user:passwort
